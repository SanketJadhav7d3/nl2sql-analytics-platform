# Copy to .env and adjust as needed.
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Auth — change this to a long random string for any real deployment.
JWT_SECRET=dev-secret-change-me

# NL-to-SQL assistant (Google Gemini). Required for /nl-query unless LLM_PROVIDER=echo.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Optional fallback provider (Groq, OpenAI-compatible API). If set, /nl-query and
# /story automatically retry on Groq when Gemini errors (e.g. quota exhausted).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
