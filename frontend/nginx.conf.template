server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_http_version 1.1;
        # Cloud Run's edge routes by the HTTP Host header, not just TLS SNI —
        # forwarding the frontend's own Host here misroutes the request back
        # to the frontend itself. $proxy_host (the backend's own host, from
        # API_URL) is what Cloud Run expects.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /story streams Server-Sent Events — buffering/caching must stay off
        # or Nginx will wait for the whole response before forwarding it.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        chunked_transfer_encoding on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
